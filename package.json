{
  "name": "@ycforge/ycsf-nestjs-connector",
  "version": "0.0.0",
  "description": "NestJS adapter for Yandex Cloud Functions: API Gateway v2 HTTP transport and Message Queue trigger transport.",
  "author": "ycforge (https://github.com/ycforge)",
  "license": "MIT",
  "homepage": "https://github.com/ycforge/ycsf-nestjs-connector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycforge/ycsf-nestjs-connector.git"
  },
  "bugs": {
    "url": "https://github.com/ycforge/ycsf-nestjs-connector/issues"
  },
  "keywords": [
    "nestjs",
    "yandex-cloud",
    "cloud-functions",
    "api-gateway",
    "message-queue",
    "serverless"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
